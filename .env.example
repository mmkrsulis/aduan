SECRET_KEY=replace-with-a-long-random-value
MPWA_BASE_URL=http://host.docker.internal:18082
MPWA_API_KEY=
MPWA_SENDER=
WEBHOOK_SECRET=replace-with-a-random-webhook-secret
BOOTSTRAP_PASSWORD=replace-with-a-strong-initial-password
# Absolute host path to the Firebase service-account JSON. Never commit the file.
FCM_SERVICE_ACCOUNT_FILE_HOST=/secure/path/firebase-service-account.json
